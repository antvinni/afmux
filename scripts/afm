#!/usr/bin/env python3
"""afm: run agent-written, test-gated implementation steps on the on-device Apple Foundation Model.

    afm run <steps-dir>     run every step in filename order, stop at the first failure
    afm step <step-file>    run one step

Exit codes: 0 all steps passed, 1 a step failed its tests or fm failed on it, 2 usage,
4 fm missing or model unavailable, 5 blocked by a sandbox, 6 a step's prompt is over budget.
"""
import argparse
import json
import math
import os
import re
import signal
import subprocess
import sys
import tempfile
import time

EXIT_OK, EXIT_FAIL, EXIT_USAGE, EXIT_UNAVAILABLE, EXIT_SANDBOX, EXIT_BUDGET = 0, 1, 2, 4, 5, 6

DEFAULT_BUDGET = 7168
DEFAULT_TIMEOUT = 120
DEFAULT_RETRIES = 1
DEFAULT_CHUNK_TOKENS = 600
TEST_TIMEOUT = 120
USAGE = "afm run <steps-dir> [--retries N] [--timeout S] [--budget T] [--json] | afm step <step-file> [options] | afm read <file> --ask \"question\" [--chunk-tokens N] [--json]"
HANDLED_SIGNALS = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
HEADER_KEYS = ("file", "test", "context")
_ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
_FENCE = re.compile(r"^\s*```[A-Za-z0-9_+-]*[ \t]*\n(.*?)\n```\s*$", re.S)

INSTRUCTIONS = ("You are a code implementer. Reply with source code only: no explanation, no markdown fences, "
                "no tests, no example usage. Use only the standard library unless the spec says otherwise. "
                "The code will be saved as %s and imported.")


class AfmError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


class Step(object):
    def __init__(self, step_id, path, file, test, context, spec):
        self.id = step_id
        self.path = path
        self.file = file
        self.test = test
        self.context = context
        self.spec = spec


# --- step files ---------------------------------------------------------------

def parse_step(path):
    step_id = os.path.splitext(os.path.basename(path))[0]
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except OSError as e:
        raise AfmError(EXIT_USAGE, "cannot read step %s (%s)" % (path, e))
    if "\n---\n" not in text and not text.startswith("---\n"):
        raise AfmError(EXIT_USAGE, "step %s: no '---' line separating the header from the spec" % step_id)
    header, _, spec = text.partition("\n---\n") if not text.startswith("---\n") else ("", "", text[4:])
    fields = {}
    for line in header.splitlines():
        if not line.strip():
            continue
        key, sep, value = line.partition(":")
        key = key.strip()
        if not sep or key not in HEADER_KEYS:
            raise AfmError(EXIT_USAGE, "step %s: unknown header line %r (allowed: %s)" % (step_id, line, ", ".join(HEADER_KEYS)))
        value = re.split(r"\s+#", value, maxsplit=1)[0].strip()   # a trailing "  # comment" is allowed
        fields[key] = value
    if not fields.get("file"):
        raise AfmError(EXIT_USAGE, "step %s: missing 'file:' header (the one file this step writes)" % step_id)
    if not fields.get("test"):
        raise AfmError(EXIT_USAGE, "step %s: missing 'test:' header (the command that judges the step)" % step_id)
    spec = spec.strip()
    if not spec:
        raise AfmError(EXIT_USAGE, "step %s: the spec after '---' is empty" % step_id)
    context = [c.strip() for c in fields.get("context", "").split(",") if c.strip()]
    return Step(step_id, path, fields["file"], fields["test"], context, spec)


def check_context(steps):
    """Every context file must exist now or be the file an earlier step writes."""
    produced = set()
    for step in steps:
        for c in step.context:
            if not os.path.isfile(c) and c not in produced:
                raise AfmError(EXIT_USAGE, "step %s: context file not found: %s (it is not written by an earlier step either)" % (step.id, c))
        produced.add(step.file)


def load_steps(directory):
    if not os.path.isdir(directory):
        raise AfmError(EXIT_USAGE, "steps directory not found: %s" % directory)
    names = sorted(n for n in os.listdir(directory) if n.endswith(".md"))
    if not names:
        raise AfmError(EXIT_USAGE, "no step files (*.md) in %s" % directory)
    steps = [parse_step(os.path.join(directory, n)) for n in names]
    check_context(steps)
    return steps


# --- running fm ---------------------------------------------------------------

_CHILD = None
_TIMEOUT = DEFAULT_TIMEOUT


def run_fm(args, stdin_text, timeout=None):
    """Run fm with one failure policy: cannot run -> 4, sandbox 1008 -> 5, timeout -> AfmError(1)."""
    global _CHILD
    timeout = timeout or _TIMEOUT
    signal.pthread_sigmask(signal.SIG_BLOCK, HANDLED_SIGNALS)
    try:
        try:
            proc = subprocess.Popen(["fm"] + args, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                    stderr=subprocess.PIPE, text=True)
        except OSError as e:
            raise AfmError(EXIT_UNAVAILABLE, "fm not found or not executable (%s)" % e)
        _CHILD = proc
    finally:
        signal.pthread_sigmask(signal.SIG_UNBLOCK, HANDLED_SIGNALS)
    try:
        out, err = proc.communicate(stdin_text, timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.communicate()
        raise AfmError(EXIT_FAIL, "timed out after %g s" % timeout)
    finally:
        _CHILD = None
    err = _ANSI.sub("", err)
    if proc.returncode != 0 and "ModelManager" in err and "1008" in err:
        raise AfmError(EXIT_SANDBOX, "fm is blocked by a sandbox; run afm outside it")
    return proc.returncode, out, err


def count_tokens(text, instructions=""):
    args = ["count-tokens", "-q"]
    if instructions:
        args.append("--instructions=" + instructions)
    code, out, err = run_fm(args, text)
    if code != 0:
        raise AfmError(EXIT_FAIL, err.strip() or "fm count-tokens failed with exit %d" % code)
    try:
        return int(out.strip())
    except ValueError:
        raise AfmError(EXIT_FAIL, "fm count-tokens returned %r" % out.strip())


def generate(instructions, prompt, timeout, greedy=True):
    """One model call. Returns the code, or raises AfmError(EXIT_FAIL) with fm's message.

    The first attempt is greedy (deterministic). Retries sample, otherwise a retry with the
    same prompt context tends to reproduce the same code byte for byte.
    """
    args = ["respond", "--no-stream"] + (["--greedy"] if greedy else []) + ["--instructions=" + instructions]
    code, out, err = run_fm(args, prompt, timeout=timeout)
    if code != 0:
        acode, _, aerr = run_fm(["available"], "")
        if acode != 0:
            raise AfmError(EXIT_UNAVAILABLE, aerr.strip() or "model not available")
        raise AfmError(EXIT_FAIL, err.strip() or "fm respond failed with exit %d" % code)
    text = strip_fence(out)
    if not text.strip():
        raise AfmError(EXIT_FAIL, "model returned no output")
    return text


def strip_fence(text):
    m = _FENCE.match(text)
    if m:
        text = m.group(1)
    return text.rstrip() + "\n"


# --- prompts -------------------------------------------------------------------

def read_file(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


def build_prompt(step, current, previous=None, test_output=None):
    parts = [step.spec]
    if current is not None:
        parts.append("Current contents of %s. Output the complete modified file:\n\n%s" % (step.file, current))
    for path in step.context:
        if not os.path.isfile(path):
            raise AfmError(EXIT_USAGE, "step %s: context file not found: %s" % (step.id, path))
        parts.append("Reference only, do not modify: %s\n\n%s" % (path, read_file(path)))
    if previous is not None:
        parts.append("Your previous implementation:\n\n%s" % previous)
        parts.append("It failed these tests. Output the complete corrected file:\n\n%s" % (test_output or "")[-1800:])
    return "\n\n".join(p.rstrip() for p in parts) + "\n"


# --- running a step -------------------------------------------------------------

_TEST_COUNT = re.compile(r"Ran (\d+) tests?|(\d+) passed|collected (\d+) items?")


def tests_run(output):
    """How many tests the command reported running, or None if it didn't say."""
    total = None
    for m in _TEST_COUNT.finditer(output or ""):
        n = int(next(g for g in m.groups() if g is not None))
        total = n if total is None else total + n
    return total


def run_tests(command):
    try:
        p = subprocess.run(command, shell=True, capture_output=True, text=True, timeout=TEST_TIMEOUT)
        return p.returncode == 0, (p.stdout + p.stderr)
    except subprocess.TimeoutExpired:
        return False, "test command timed out after %d s" % TEST_TIMEOUT


def write_file(path, content):
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)
    if path.endswith(".py"):
        # a same-size rewrite within one second would otherwise load stale bytecode
        cache = os.path.join(d or ".", "__pycache__")
        stem = os.path.splitext(os.path.basename(path))[0] + "."
        if os.path.isdir(cache):
            for name in os.listdir(cache):
                if name.startswith(stem) and name.endswith(".pyc"):
                    try:
                        os.unlink(os.path.join(cache, name))
                    except OSError:
                        pass


def failure_summary(output):
    """One line that says why a test run failed: the first failing test and the exception line."""
    lines = [ln.strip() for ln in (output or "").splitlines() if ln.strip()]
    test = exc = None
    for ln in lines:
        if test is None and re.match(r"^(FAIL|ERROR): ", ln):
            test = ln
        if re.match(r"^[A-Za-z_.]*(Error|Exception|Warning)\b", ln) and not ln.startswith("Traceback"):
            exc = ln
            if test is not None:
                break
    parts = [x for x in (test, exc) if x]
    if parts:
        return " | ".join(parts)[:240]
    for ln in reversed(lines):
        if "Error" in ln or ln.startswith("Traceback"):
            return ln[:240]
    return lines[-1][:240] if lines else "no output"


def duplicate_definitions(code):
    names = re.findall(r"^(?:def|class) ([A-Za-z_]\w*)", code, re.M)
    return sorted({n for n in names if names.count(n) > 1})


def clear_failed(step):
    for suffix in (".afm-failed", ".afm-failed.log"):
        try:
            os.unlink(step.file + suffix)
        except OSError:
            pass


def run_step(step, args, earlier=()):
    """Returns (result, attempts, seconds, notes, failure) where failure is None or a dict.

    earlier: steps that passed before this one in the run; their tests are rerun after this
    step passes its own, so a whole-file rewrite cannot silently break them.
    """
    t0 = time.time()
    existed = os.path.isfile(step.file)
    original = read_file(step.file) if existed else None
    notes = []
    if existed:
        ok, out0 = run_tests(step.test)
        n0 = tests_run(out0)
        if ok:
            clear_failed(step)
            notes.append("already passing, not regenerated")
            if n0 == 0:
                notes.append("warning: the test command ran 0 tests")
            notes.append("tests run: %s" % ("unknown" if n0 is None else n0))
            return "pass", 0, time.time() - t0, notes, None
        notes.append("existing %s failed its test; regenerating it (it is restored if every attempt fails)" % step.file)
    instructions = INSTRUCTIONS % step.file
    previous = output = None
    attempts = 0
    code = ""
    while attempts <= args.retries:
        attempts += 1
        prompt = build_prompt(step, original, previous, output)
        used = count_tokens(prompt, instructions)
        if used > args.budget:
            raise AfmError(EXIT_BUDGET, "step %s: prompt is %d tokens, budget is %d; split the step or trim its context"
                           % (step.id, used, args.budget))
        try:
            new_code = generate(instructions, prompt, args.timeout, greedy=(attempts == 1))
        except AfmError as e:
            if e.code != EXIT_FAIL:
                raise
            output = "fm: " + e.message
            previous = code or "(no code produced)"
            notes.append("attempt %d failed: %s" % (attempts, e.message[:160]))
            continue
        if previous is not None and new_code == previous:
            notes.append("attempt %d produced identical code; not retested" % attempts)
            break
        code = new_code
        write_file(step.file, code)
        ok, output = run_tests(step.test)
        if ok:
            broken = None
            for e in earlier:
                eok, eout = run_tests(e.test)
                if not eok:
                    broken = (e, eout)
                    break
            if broken is None:
                clear_failed(step)
                dups = duplicate_definitions(code) if step.file.endswith(".py") else []
                if dups:
                    notes.append("warning: duplicate top-level definition of %s; the last one wins" % ", ".join(dups))
                n = tests_run(output)
                if n == 0:
                    notes.append("warning: the test command ran 0 tests")
                notes.append("tests run: %s" % ("unknown" if n is None else n))
                return "pass", attempts, time.time() - t0, notes, None
            e, eout = broken
            output = ("regression: this step's rewrite of %s broke step %s (test: %s). Keep every existing "
                      "function unchanged.\n\n%s" % (step.file, e.id, e.test, eout))
        notes.append("attempt %d failed: %s" % (attempts, failure_summary(output)))
        previous = code
    saved = step.file + ".afm-failed"
    write_file(saved, code if code else "(no code produced)\n")
    write_file(saved + ".log", "test: %s\n\n%s" % (step.test, output or ""))
    if existed:
        write_file(step.file, original)
        restored = "%s restored" % step.file
    else:
        try:
            os.unlink(step.file)
        except OSError:
            pass
        restored = "%s removed (did not exist before)" % step.file
    return "FAIL", attempts, time.time() - t0, notes, {"id": step.id, "test": step.test, "output": output or "",
                                                         "saved": saved, "log": saved + ".log", "restored": restored}


# --- reports --------------------------------------------------------------------

def head_tail(text, head=25, tail=25):
    lines = text.strip().splitlines()
    if len(lines) <= head + tail:
        return "\n".join(lines)
    return "\n".join(lines[:head] + ["... %d lines omitted, full output in the .afm-failed.log file ..." % (len(lines) - head - tail)] + lines[-tail:])


def report_text(rows, failed):
    w_id = max(len("step"), max(len(r["id"]) for r in rows))
    w_file = max(len("file"), max(len(r["file"]) for r in rows))
    lines = ["%-*s  %-*s  %-7s  %-8s  %s" % (w_id, "step", w_file, "file", "result", "attempts", "seconds")]
    for r in rows:
        extra = "  (%s)" % r["notes"][0] if r["attempts"] == 0 and r["notes"] else ""
        att = r["attempts"] if r["result"] != "skipped" else "-"
        secs = ("%.1f" % r["seconds"]) if r["result"] != "skipped" else "-"
        lines.append("%-*s  %-*s  %-7s  %-8s  %s%s" % (w_id, r["id"], w_file, r["file"], r["result"], att, secs, extra))
    noted = [r for r in rows if [n for n in r["notes"] if not n.startswith("tests run:")] and r["attempts"] > 0]
    if noted:
        lines.append("")
        for r in noted:
            for n in r["notes"]:
                if not n.startswith("tests run:"):
                    lines.append("%s: %s" % (r["id"], n))
    if not failed:
        done = [r for r in rows if r["result"] == "pass"]
        tests = 0
        for r in done:
            for n in r["notes"]:
                if n.startswith("tests run: ") and n[11:].isdigit():
                    tests += int(n[11:])
        retries = sum(max(0, r["attempts"] - 1) for r in done)
        warnings = sum(1 for r in rows for n in r["notes"] if n.startswith("warning"))
        lines += ["", "%d/%d steps passed, %d tests, %d retries, %d warnings" % (len(done), len(rows), tests, retries, warnings)]
    if failed:
        lines += ["", "step %s failed after %d attempt%s" % (failed["id"], failed["attempts"], "" if failed["attempts"] == 1 else "s"),
                  "test: %s" % failed["test"], head_tail(failed["output"]),
                  "attempt saved at %s, test output at %s; %s" % (failed["saved"], failed["log"], failed["restored"])]
    return "\n".join(lines) + "\n"


def report_json(rows, failed):
    out = {"steps": rows, "failed": None}
    if failed:
        out["failed"] = {k: failed[k] for k in ("id", "test", "output", "saved", "log")}
    return json.dumps(out, indent=1) + "\n"


_TEMP_FILES = []


def write_temp_schema(obj):
    signal.pthread_sigmask(signal.SIG_BLOCK, HANDLED_SIGNALS)
    try:
        fd, path = tempfile.mkstemp(prefix="afm-schema-", suffix=".json")
        _TEMP_FILES.append(path)
    finally:
        signal.pthread_sigmask(signal.SIG_UNBLOCK, HANDLED_SIGNALS)
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f)
    return path


def cleanup_temp():
    while _TEMP_FILES:
        try:
            os.unlink(_TEMP_FILES.pop())
        except OSError:
            pass


class Unit(object):
    def __init__(self, text, sep, line):
        self.text = text
        self.sep = sep
        self.line = line


def split_units(text):
    """Non-blank paragraphs separated by blank lines, each with its first line number."""
    units = []
    line = 1
    pos = 0
    for m in re.finditer(r"\n[ \t]*\n+", text):
        _add_unit(units, text[pos:m.start()], line)
        line += text[pos:m.end()].count("\n")
        pos = m.end()
    _add_unit(units, text[pos:], line)
    return units


def _add_unit(units, chunk, line):
    if not chunk.strip():
        return
    stripped = chunk.lstrip("\n")
    units.append(Unit(stripped.rstrip("\n"), "" if not units else "\n\n", line + (len(chunk) - len(stripped))))


def _join(units):
    return "".join((u.sep if i else "") + u.text for i, u in enumerate(units))


# --- read mode: answer a question about a file, one small chunk at a time ---------------

READ_INSTRUCTIONS = ("You are given one chunk of a longer document and a question. If this chunk contains a passage that "
                     "answers the question, set found to true and copy that passage into quote exactly as written, one to "
                     "three sentences. If the chunk does not answer the question, set found to false and leave quote empty. "
                     "Never write anything that is not in the chunk. Question: %s")

READ_SCHEMA = {
    "title": "Extract",
    "type": "object",
    "properties": {"found": {"type": "boolean"}, "quote": {"type": "string"}},
    "required": ["found", "quote"],
    "x-order": ["found", "quote"],
    "additionalProperties": False,
}


def chunk_document(text, chunk_tokens, total_tokens):
    """Pack paragraphs into chunks of about chunk_tokens, by the file's measured tokens-per-byte ratio.

    Returns a list of (text, first_line, last_line)."""
    ratio = float(max(1, total_tokens)) / max(1, len(text.encode()))
    units = split_units(text)
    chunks = []
    cur, cur_bytes, first = [], 0, None
    for u in units:
        b = len(u.text.encode()) + 2
        if cur and (cur_bytes + b) * ratio > chunk_tokens:
            chunks.append((_join(cur), first, cur[-1].line + cur[-1].text.count("\n")))
            cur, cur_bytes, first = [], 0, None
        if first is None:
            first = u.line
        cur.append(u)
        cur_bytes += b
    if cur:
        chunks.append((_join(cur), first, cur[-1].line + cur[-1].text.count("\n")))
    return chunks


def _norm(text):
    return re.sub(r"\s+", " ", text).strip().lower()


def read_file_answers(path, question, args):
    text = read_file(path).replace("\r\n", "\n")
    if not text.strip():
        raise AfmError(EXIT_USAGE, "%s is empty" % path)
    total = count_tokens(text)
    chunks = chunk_document(text, args.chunk_tokens, total)
    schema_path = write_temp_schema(READ_SCHEMA)
    instructions = READ_INSTRUCTIONS % question.strip()
    answers, dropped = [], 0
    for ctext, first, last in chunks:
        prompt = "Chunk lines %d-%d of %s\n---\n%s" % (first, last, os.path.basename(path), ctext)
        code, out, err = run_fm(["respond", "--no-stream", "--greedy", "--instructions=" + instructions, "--schema", schema_path],
                                prompt, timeout=args.timeout)
        if code != 0:
            acode, _, aerr = run_fm(["available"], "")
            if acode != 0:
                raise AfmError(EXIT_UNAVAILABLE, aerr.strip() or "model not available")
            raise AfmError(EXIT_FAIL, "chunk lines %d-%d: %s" % (first, last, err.strip() or "fm respond failed"))
        try:
            obj = json.loads(out)
        except ValueError:
            dropped += 1
            continue
        if not isinstance(obj, dict) or not obj.get("found"):
            continue
        quote = str(obj.get("quote") or "")
        if not quote.strip() or _norm(quote) not in _norm(ctext):
            dropped += 1
            continue
        answers.append({"lines": "%d-%d" % (first, last), "quote": quote.strip()})
    return {"file": path, "question": question, "chunks": len(chunks), "tokens": total, "dropped": dropped, "answers": answers}


def report_read(res, as_json):
    if as_json:
        return json.dumps(res, indent=1, ensure_ascii=False) + "\n"
    lines = []
    if res["answers"]:
        lines.append("%d of %d chunks matched (%d tokens read locally%s)" % (
            len(res["answers"]), res["chunks"], res["tokens"], ", %d dropped: quote not in text" % res["dropped"] if res["dropped"] else ""))
        for a in res["answers"]:
            lines.append("[lines %s] \"%s\"" % (a["lines"], a["quote"]))
    else:
        lines.append("no chunk matched the question (%d chunks, %d tokens read locally%s)" % (
            res["chunks"], res["tokens"], ", %d dropped: quote not in text" % res["dropped"] if res["dropped"] else ""))
    return "\n".join(lines) + "\n"


# --- lifecycle ------------------------------------------------------------------

def _on_signal(signum, frame):
    child = _CHILD
    if child is not None and child.poll() is None:
        try:
            child.kill()
        except OSError:
            pass
    cleanup_temp()
    sys.stderr.write("afm: interrupted by signal %d\n" % signum)
    sys.stderr.flush()
    os._exit(EXIT_FAIL)


def install_signal_handlers():
    for sig in HANDLED_SIGNALS:
        signal.signal(sig, _on_signal)


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        raise AfmError(EXIT_USAGE, "%s\nusage: %s" % (message, USAGE))


HELP_EPILOG = """step file (steps/01-name.md), header then --- then the spec:
  file: src/util.py                          the one file this step writes (relative to the current directory)
  test: python3 -m unittest tests.test_util  run from the current directory; exit 0 means the step passed
  context: src/types.py, src/errors.py       optional, comma-separated read-only files shown to the model
  ---
  Write a Python function ...

A step whose test already passes against the current file is reported as done and not regenerated,
so reruns skip finished steps and leave hand-written ones alone. On a final failure the original file
is restored (or a new one removed) and the attempt is kept at <file>.afm-failed with the test output
at <file>.afm-failed.log. Exit codes: 0 all passed, 1 a step failed, 2 usage, 4 fm unavailable,
5 sandbox, 6 a step's prompt over budget."""


def parse_args(argv):
    p = _Parser(prog="afm", usage=USAGE, epilog=HELP_EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter,
                description="Implement agent-written, test-gated steps on the on-device Apple Foundation Model.")
    p.add_argument("command", nargs="?", choices=["run", "step", "read"],
                   help="run: every step in a directory in filename order; step: one step file; read: answer a question about a file chunk by chunk")
    p.add_argument("target", nargs="?", help="the steps directory (run), the step file (step), or the document (read)")
    p.add_argument("--ask", help="read: the question to answer from the file")
    p.add_argument("--chunk-tokens", dest="chunk_tokens", type=int, default=DEFAULT_CHUNK_TOKENS,
                   help="read: target size of each chunk the model sees (default %(default)s)")
    p.add_argument("--retries", type=int, default=DEFAULT_RETRIES, help="retries per step, each shown the failing test output (default %(default)s)")
    p.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT, help="seconds per model call (default %(default)s)")
    p.add_argument("--budget", type=int, default=DEFAULT_BUDGET, help="maximum prompt tokens per call (default %(default)s)")
    p.add_argument("--json", action="store_true", help="machine-readable report on stdout")
    args = p.parse_args(argv)
    if not args.command or not args.target:
        raise AfmError(EXIT_USAGE, "usage: " + USAGE)
    if args.retries < 0:
        raise AfmError(EXIT_USAGE, "--retries must be 0 or more")
    if not (args.timeout > 0) or math.isinf(args.timeout):
        raise AfmError(EXIT_USAGE, "--timeout must be a positive number of seconds")
    if args.budget < 1:
        raise AfmError(EXIT_USAGE, "--budget must be at least 1")
    if args.command == "read":
        if not args.ask or not args.ask.strip():
            raise AfmError(EXIT_USAGE, "read needs --ask \"question\"")
        if args.chunk_tokens < 50:
            raise AfmError(EXIT_USAGE, "--chunk-tokens must be at least 50")
    return args


def main(argv):
    global _TIMEOUT
    install_signal_handlers()
    try:
        args = parse_args(argv)
        _TIMEOUT = args.timeout
        if args.command == "read":
            if not os.path.isfile(args.target):
                raise AfmError(EXIT_USAGE, "file not found: %s" % args.target)
            res = read_file_answers(args.target, args.ask, args)
            sys.stdout.write(report_read(res, args.json))
            return EXIT_OK
        if args.command == "run":
            steps = load_steps(args.target)
        else:
            if not os.path.isfile(args.target):
                raise AfmError(EXIT_USAGE, "step file not found: %s" % args.target)
            steps = [parse_step(args.target)]
            check_context(steps)
        rows = []
        failed = None
        passed = []
        for step in steps:
            if failed:
                rows.append({"id": step.id, "file": step.file, "result": "skipped", "attempts": 0, "seconds": 0, "notes": []})
                continue
            result, attempts, seconds, notes, failure = run_step(step, args, earlier=passed)
            if result == "pass":
                passed.append(step)
            rows.append({"id": step.id, "file": step.file, "result": result, "attempts": attempts, "seconds": round(seconds, 1), "notes": notes})
            if failure:
                failure["attempts"] = attempts
                failed = failure
        sys.stdout.write(report_json(rows, failed) if args.json else report_text(rows, failed))
        return EXIT_FAIL if failed else EXIT_OK
    except AfmError as e:
        sys.stderr.write("afm: %s\n" % e.message)
        return e.code
    finally:
        cleanup_temp()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
