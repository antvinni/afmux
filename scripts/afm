#!/usr/bin/env python3
"""afm: run a small text job on the on-device Apple Foundation Model via the fm CLI.

Exit codes: 0 ok, 1 fm failed, 2 usage, 3 bad JSON or label, 4 fm missing or
model unavailable, 5 blocked by a sandbox, 6 input over budget.
"""
import argparse
import json
import math
import os
import re
import signal
import subprocess
import sys
import tempfile

EXIT_OK, EXIT_FM, EXIT_USAGE, EXIT_JSON, EXIT_UNAVAILABLE, EXIT_SANDBOX, EXIT_BUDGET = 0, 1, 2, 3, 4, 5, 6

HERE = os.path.dirname(os.path.realpath(__file__))
PRESETS_DIR = os.path.join(os.path.dirname(HERE), "presets")
DEFAULT_BUDGET = 7168
DEFAULT_TIMEOUT = 120
DEFAULT_MAX_CHUNKS = 8
DEFAULT_GUARDRAILS = "permissive-content-transformations"
DEFAULT_USE_CASE = "general"
PRESET_NAMES = ("summarise", "classify", "extract", "commit-msg")
USAGE = "usage: afm <preset> [options] < input | afm ask \"<instructions>\" [options] < input | afm --list"
HANDLED_SIGNALS = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
_ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


class AfmError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


class Job(object):
    def __init__(self, name, instructions, labels=None, schema_path=None):
        self.name = name
        self.instructions = instructions
        self.labels = labels
        self.schema_path = schema_path


def list_presets():
    out = []
    for name in sorted(os.listdir(PRESETS_DIR)):
        if name.endswith(".md"):
            with open(os.path.join(PRESETS_DIR, name)) as f:
                first = f.readline().strip()
            out.append((name[:-3], first))
    return out


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        raise AfmError(EXIT_USAGE, "%s\n%s" % (message, USAGE))


def parse_args(argv):
    p = _Parser(prog="afm", add_help=True, usage=USAGE)
    p.add_argument("job", nargs="?", help="preset name or 'ask'")
    p.add_argument("instructions", nargs="?", help="instructions, with 'ask' only")
    p.add_argument("--labels", help="classify only: comma-separated allowed labels")
    p.add_argument("--schema", help="JSON schema file for structured output")
    p.add_argument("--guardrails", default=DEFAULT_GUARDRAILS)
    p.add_argument("--use-case", dest="use_case", default=DEFAULT_USE_CASE)
    p.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    p.add_argument("--budget", type=int, default=DEFAULT_BUDGET)
    p.add_argument("--chunk", action="store_true")
    p.add_argument("--max-chunks", dest="max_chunks", type=int, default=DEFAULT_MAX_CHUNKS)
    p.add_argument("--list", action="store_true")
    args = p.parse_args(argv)
    if not (args.timeout > 0) or math.isinf(args.timeout):
        raise AfmError(EXIT_USAGE, "--timeout must be a positive number of seconds")
    if args.budget < 1:
        raise AfmError(EXIT_USAGE, "--budget must be at least 1")
    if args.max_chunks < 1:
        raise AfmError(EXIT_USAGE, "--max-chunks must be at least 1")
    return args


def parse_labels(text):
    labels = [x.strip() for x in text.split(",")]
    if any(not x for x in labels):
        raise AfmError(EXIT_USAGE, "empty label in --labels (labels are comma-separated and cannot contain commas)")
    if len(set(labels)) != len(labels):
        raise AfmError(EXIT_USAGE, "duplicate label in --labels")
    for label in labels:
        if any(ch in label for ch in "\"'\\"):
            raise AfmError(EXIT_USAGE, "label %r: quotes and backslashes are not allowed in labels" % label)
    return labels


def load_preset(name):
    path = os.path.join(PRESETS_DIR, name + ".md")
    with open(path) as f:
        return f.read().strip()


def check_schema_file(path):
    if not os.path.isfile(path):
        raise AfmError(EXIT_USAGE, "schema file not found: %s" % path)
    try:
        with open(path, encoding="utf-8") as f:
            obj = json.load(f)
    except (OSError, ValueError, UnicodeDecodeError) as e:
        raise AfmError(EXIT_USAGE, "schema file %s is not valid JSON (%s)" % (path, e))
    if not isinstance(obj, dict) or "x-order" not in obj:
        raise AfmError(EXIT_USAGE, "schema file %s must be an object with an x-order key; generate it with "
                                   "fm schema object --name X --string a --integer b" % path)


def resolve_job(args):
    if not args.job:
        raise AfmError(EXIT_USAGE, USAGE)
    if args.job == "ask":
        if not args.instructions:
            raise AfmError(EXIT_USAGE, "ask needs instructions as its argument")
        instructions = args.instructions
    elif args.job in PRESET_NAMES:
        if args.instructions:
            raise AfmError(EXIT_USAGE, "unexpected argument %r (only ask takes instructions)" % args.instructions)
        instructions = load_preset(args.job)
    else:
        raise AfmError(EXIT_USAGE, "unknown preset %r; run afm --list" % args.job)
    labels = None
    if args.job == "classify":
        if not args.labels:
            raise AfmError(EXIT_USAGE, "classify needs --labels a,b,c")
        if args.schema:
            raise AfmError(EXIT_USAGE, "--schema is not allowed with classify (its schema is generated)")
        labels = parse_labels(args.labels)
        instructions = instructions.replace("{labels}", ", ".join(labels))
    elif args.labels:
        raise AfmError(EXIT_USAGE, "--labels is only for classify")
    if args.job == "extract" and not args.schema:
        raise AfmError(EXIT_USAGE, "extract needs --schema FILE")
    if args.job == "commit-msg" and args.chunk:
        raise AfmError(EXIT_USAGE, "--chunk is not allowed with commit-msg; pipe a smaller diff")
    if args.schema:
        check_schema_file(args.schema)
    return Job(args.job, instructions, labels, args.schema)


def read_input():
    if sys.stdin.isatty():
        raise AfmError(EXIT_USAGE, "afm reads its input from stdin; pipe or redirect it")
    text = sys.stdin.buffer.read().decode("utf-8", errors="replace")
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    if not text.strip():
        raise AfmError(EXIT_USAGE, "input is empty")
    return text


# --- running fm --------------------------------------------------------------

_CHILD = None
_TEMP_FILES = []
_TIMEOUT = DEFAULT_TIMEOUT


def _strip_ansi(text):
    return _ANSI.sub("", text)


def run_fm(args, stdin_text, timeout=None):
    """Run fm with one failure policy: cannot run -> 4, sandbox 1008 -> 5, timeout -> 1."""
    global _CHILD
    timeout = timeout or _TIMEOUT
    signal.pthread_sigmask(signal.SIG_BLOCK, HANDLED_SIGNALS)
    try:
        try:
            proc = subprocess.Popen(["fm"] + args, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                    stderr=subprocess.PIPE, text=True)
        except OSError as e:
            raise AfmError(EXIT_UNAVAILABLE, "fm not found or not executable (%s)" % e)
        _CHILD = proc
    finally:
        signal.pthread_sigmask(signal.SIG_UNBLOCK, HANDLED_SIGNALS)
    try:
        out, err = proc.communicate(stdin_text, timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.communicate()
        raise AfmError(EXIT_FM, "timed out after %g s" % timeout)
    finally:
        _CHILD = None
    err = _strip_ansi(err)
    if proc.returncode != 0 and "ModelManager" in err and "1008" in err:
        raise AfmError(EXIT_SANDBOX, "fm is blocked by a sandbox; run afm outside it")
    return proc.returncode, out, err


def count_tokens(text, instructions=""):
    args = ["count-tokens", "-q"]
    if instructions:
        args.append("--instructions=" + instructions)
    code, out, err = run_fm(args, text)
    if code != 0:
        raise AfmError(EXIT_FM, err.strip() or "fm count-tokens failed with exit %d" % code)
    try:
        return int(out.strip())
    except ValueError:
        raise AfmError(EXIT_FM, "fm count-tokens returned %r" % out.strip())


def schema_tokens(path):
    with open(path, encoding="utf-8") as f:
        return count_tokens(f.read())


def check_budget(total, budget, args, job):
    if total <= budget or args.chunk:
        return
    if job.name == "commit-msg":
        advice = "pipe a smaller diff, for example { git diff --cached --stat; git diff --cached -U1; }"
    else:
        advice = "rerun with --chunk"
    raise AfmError(EXIT_BUDGET, "input is %d tokens, budget is %d; %s" % (total, budget, advice))


def respond(job, text, args, schema_path):
    cmd = ["respond", "--no-stream", "--greedy", "--instructions=" + job.instructions,
           "--guardrails", args.guardrails, "--use-case", args.use_case]
    if schema_path:
        cmd += ["--schema", schema_path]
    code, out, err = run_fm(cmd, text, timeout=args.timeout)
    if code != 0:
        acode, _, aerr = run_fm(["available"], "")
        if acode != 0:
            raise AfmError(EXIT_UNAVAILABLE, aerr.strip() or "model not available")
        raise AfmError(EXIT_FM, err.strip() or "fm respond failed with exit %d" % code)
    if not out.strip():
        raise AfmError(EXIT_FM, "model returned no output")
    return out


# --- schemas and answers ----------------------------------------------------

def classify_schema(labels):
    return {
        "title": "Classification",
        "type": "object",
        "properties": {"label": {"type": "string", "enum": list(labels)}},
        "required": ["label"],
        "x-order": ["label"],
        "additionalProperties": False,
    }


def write_temp_schema(obj):
    signal.pthread_sigmask(signal.SIG_BLOCK, HANDLED_SIGNALS)
    try:
        fd, path = tempfile.mkstemp(prefix="afm-schema-", suffix=".json")
        _TEMP_FILES.append(path)
    finally:
        signal.pthread_sigmask(signal.SIG_UNBLOCK, HANDLED_SIGNALS)
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f)
    return path


def parse_answer(raw, job, schema_path):
    if not schema_path:
        return raw.rstrip()
    try:
        obj = json.loads(raw)
    except ValueError:
        raise AfmError(EXIT_JSON, "model output is not valid JSON:\n%s" % raw.rstrip())
    if job.labels is not None:
        label = obj.get("label") if isinstance(obj, dict) else None
        if label not in job.labels:
            raise AfmError(EXIT_JSON, "label %r is not one of %s" % (label, ", ".join(job.labels)))
    return json.dumps(obj, separators=(",", ":"), ensure_ascii=False)


# --- chunking ---------------------------------------------------------------

class Unit(object):
    def __init__(self, text, sep, line):
        self.text = text
        self.sep = sep
        self.line = line


def split_units(text):
    """Non-blank paragraphs separated by blank lines, each with its first line number."""
    units = []
    line = 1
    pos = 0
    for m in re.finditer(r"\n[ \t]*\n+", text):
        _add_unit(units, text[pos:m.start()], "\n\n", line)
        line += text[pos:m.end()].count("\n")
        pos = m.end()
    _add_unit(units, text[pos:], "\n\n", line)
    return units


def _add_unit(units, chunk, sep, line):
    """Append chunk as a unit unless it is only whitespace; leading blank lines are skipped."""
    if not chunk.strip():
        return
    stripped = chunk.lstrip("\n")
    units.append(Unit(stripped.rstrip("\n"), "" if not units else sep, line + (len(chunk) - len(stripped))))


def _explode_lines(unit):
    out = []
    for i, ln in enumerate(unit.text.split("\n")):
        if not ln.strip():
            continue
        out.append(Unit(ln, unit.sep if not out else "\n", unit.line + i))
    return out


def _join(units):
    return "".join((u.sep if i else "") + u.text for i, u in enumerate(units))


def plan_chunks(text, job, overhead, budget, max_chunks, total_tokens):
    """Pack units greedily by a byte ratio, confirm each piece with fm count-tokens.

    overhead is the token cost of the schema (if any); the instructions are
    counted once here and the ratio is built from the input alone.
    """
    instr_tokens = count_tokens(job.instructions)
    fixed = overhead + instr_tokens
    ratio = float(max(1, total_tokens - instr_tokens)) / max(1, len(text.encode()))
    units = split_units(text)
    pieces = []
    i = 0
    while i < len(units):
        piece = []
        nbytes = 0
        while i < len(units):
            b = len(units[i].text.encode()) + len(units[i].sep.encode())
            if piece and (nbytes + b) * ratio + fixed > budget:
                break
            piece.append(units[i])
            nbytes += b
            i += 1
        while True:
            candidate = _join(piece)
            if count_tokens(candidate, job.instructions) + overhead <= budget:
                break
            if len(piece) > 1:
                piece.pop()
                i -= 1
                continue
            u = piece[0]
            if "\n" in u.text:
                units[i - 1:i] = _explode_lines(u)
                i -= 1
                piece = []
                break
            n = count_tokens(u.text)
            raise AfmError(EXIT_BUDGET, "line %d is %d tokens plus %d for instructions and schema, budget is %d"
                           % (u.line, n, fixed, budget))
        if not piece:
            continue
        pieces.append(candidate)
        if len(pieces) > max_chunks:
            raise AfmError(EXIT_BUDGET, "input needs more than %d chunks, max is %d" % (max_chunks, max_chunks))
    return pieces


def run_chunks(pieces, job, args, schema_path):
    n = len(pieces)
    outputs = []
    for idx, piece in enumerate(pieces, 1):
        try:
            answer = parse_answer(respond(job, piece, args, schema_path), job, schema_path)
        except AfmError as e:
            raise AfmError(e.code, "chunk %d/%d: %s" % (idx, n, e.message))
        if schema_path:
            outputs.append(answer + "\n")
        else:
            outputs.append("[%d/%d]\n%s\n" % (idx, n, answer))
    return "".join(outputs)


# --- lifecycle --------------------------------------------------------------

def cleanup():
    while _TEMP_FILES:
        path = _TEMP_FILES.pop()
        try:
            os.unlink(path)
        except OSError:
            pass


def _on_signal(signum, frame):
    child = _CHILD
    if child is not None and child.poll() is None:
        try:
            child.kill()
        except OSError:
            pass
    cleanup()
    sys.stderr.write("afm: interrupted by signal %d\n" % signum)
    sys.stderr.flush()
    os._exit(EXIT_FM)


def install_signal_handlers():
    for sig in HANDLED_SIGNALS:
        signal.signal(sig, _on_signal)


def emit_text(answer):
    sys.stdout.write(answer.rstrip() + "\n")


def main(argv):
    global _TIMEOUT
    install_signal_handlers()
    try:
        args = parse_args(argv)
        if args.list:
            for name, first in list_presets():
                print("%-12s %s" % (name, first))
            return EXIT_OK
        _TIMEOUT = args.timeout
        job = resolve_job(args)
        text = read_input()
        schema_path = job.schema_path
        if job.labels is not None:
            schema_path = write_temp_schema(classify_schema(job.labels))
        overhead = schema_tokens(schema_path) if schema_path else 0
        total = count_tokens(text, job.instructions) + overhead
        check_budget(total, args.budget, args, job)
        if args.chunk:
            pieces = plan_chunks(text, job, overhead, args.budget, args.max_chunks, total - overhead)
            sys.stdout.write(run_chunks(pieces, job, args, schema_path))
        else:
            answer = respond(job, text, args, schema_path)
            emit_text(parse_answer(answer, job, schema_path))
        return EXIT_OK
    except AfmError as e:
        sys.stderr.write("afm: %s\n" % e.message)
        return e.code
    finally:
        cleanup()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
