#!/usr/bin/env python3
"""Fake fm CLI for tests. Behaviour comes from FAKEFM_* environment variables."""
import json
import math
import os
import sys
import time


def env(name, default=None):
    return os.environ.get(name, default)


def instructions_of(cmd):
    for i, a in enumerate(cmd):
        if a.startswith("--instructions="):
            return a[len("--instructions="):]
        if a in ("-i", "--instructions") and i + 1 < len(cmd):
            return cmd[i + 1]
    return ""


def log(cmd, stdin):
    path = env("FAKEFM_LOG")
    if path:
        entry = {"cmd": cmd, "stdin": stdin, "pid": os.getpid()}
        if "--schema" in cmd:
            try:
                with open(cmd[cmd.index("--schema") + 1]) as f:
                    entry["schema"] = f.read()
            except OSError as e:
                entry["schema"] = "ERROR: %s" % e
        with open(path, "a") as f:
            f.write(json.dumps(entry) + "\n")


def count_calls(sub):
    path = env("FAKEFM_LOG")
    if not path or not os.path.exists(path):
        return 0
    with open(path) as f:
        return sum(1 for line in f if json.loads(line)["cmd"][0] == sub)


def main():
    cmd = sys.argv[1:]
    sub = cmd[0] if cmd else ""
    stdin = "" if sys.stdin.isatty() else sys.stdin.read()
    log(cmd, stdin)
    if sub == "available":
        sys.stderr.write(env("FAKEFM_AVAILABLE_STDERR", ""))
        sys.exit(int(env("FAKEFM_AVAILABLE_EXIT", "0")))
    if sub == "count-tokens":
        cdelay = float(env("FAKEFM_COUNT_DELAY", "0"))
        if cdelay:
            time.sleep(cdelay)
        code = int(env("FAKEFM_COUNT_EXIT", "0"))
        if code:
            sys.stderr.write(env("FAKEFM_COUNT_STDERR", ""))
            sys.exit(code)
        fixed = env("FAKEFM_COUNT")
        if fixed is not None:
            print(fixed)
        else:
            instr = instructions_of(cmd)
            nbytes = len(stdin.encode()) + len(instr.encode())
            count = math.ceil(nbytes / 4)
            extra = env("FAKEFM_COUNT_EXTRA_IF_CONTAINS")  # "needle:N": N more tokens when stdin has needle
            if extra:
                needle, n = extra.rsplit(":", 1)
                if needle in stdin:
                    count += int(n)
            print(count)
        sys.exit(0)
    if sub == "respond":
        n = count_calls("respond")  # this call included
        if not stdin.strip():
            sys.stderr.write("Error: \x1b[38;2;255;107;128mMissing prompt. Provide a positional prompt, --text, or --image option.\x1b[0m\n")
            sys.exit(1)
        delay = float(env("FAKEFM_RESPOND_DELAY", "0"))
        if delay:
            time.sleep(delay)
        fail_on = env("FAKEFM_RESPOND_FAIL_ON_CALL")
        code = int(env("FAKEFM_RESPOND_EXIT", "0"))
        if fail_on is not None and n != int(fail_on):
            code = 0
        if code:
            sys.stderr.write(env("FAKEFM_RESPOND_STDERR", ""))
            sys.exit(code)
        seq = env("FAKEFM_RESPOND_SEQ")
        if seq:
            path = os.path.join(seq, str(n))
            if os.path.exists(path):
                with open(path) as f:
                    sys.stdout.write(f.read())
            else:
                sys.stderr.write("fakefm: no reply %d in %s\n" % (n, seq))
                sys.exit(1)
        elif env("FAKEFM_RESPOND_MODE") == "first-line":
            print(stdin.split("\n", 1)[0])
        else:
            print(env("FAKEFM_RESPOND_STDOUT", "OK"))
        sys.exit(0)
    sys.stderr.write("fakefm: unknown subcommand %r\n" % sub)
    sys.exit(64)


if __name__ == "__main__":
    main()
